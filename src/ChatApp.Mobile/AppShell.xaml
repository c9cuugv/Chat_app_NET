<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChatApp.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ChatApp.Mobile"
    xmlns:views="clr-namespace:ChatApp.Mobile.Views"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Chat Rooms"
        ContentTemplate="{DataTemplate views:ChatRoomsPage}"
        Route="ChatRoomsPage" />

</Shell>
